# ==============================================================================
# HUNKAR 24 (हुंकार 24) – ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Single Source of Truth Database, Storage, and Realtime)
# ------------------------------------------------------------------------------
# Get these from: Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# 2. CHATGPT / CUSTOM GPT DIRECT PUBLISHING INTEGRATION (Phase 8)
# ------------------------------------------------------------------------------
# API Key used by ChatGPT Custom GPT Actions to publish articles
# Header: Authorization: Bearer <HUNKAR24_API_KEY> or x-api-key: <HUNKAR24_API_KEY>
HUNKAR24_API_KEY=hunkar24_chatgpt_live_secret_key_change_me

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI (Phase 5 Hindi News Engine & Phase 7 Image Generation)
# ------------------------------------------------------------------------------
# Get key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-google-gemini-api-key
VITE_GEMINI_API_KEY=your-google-gemini-api-key

# ------------------------------------------------------------------------------
# 4. 3-HOUR AUTOMATED NEWS SCHEDULER (Phase 6)
# ------------------------------------------------------------------------------
# AUTO_NEWS_ENABLED: true | false
AUTO_NEWS_ENABLED=true
# Default interval: 180 minutes = 3 hours
AUTO_NEWS_INTERVAL_MINUTES=180
# Mode A: 'auto_safe' or 'auto_publish' (auto publishes to live site)
# Mode B: 'manual' (saves as draft for editor review)
AUTO_NEWS_PUBLISH_MODE=auto_safe

# ------------------------------------------------------------------------------
# 5. EXTERNAL NEWS AGGREGATION PROVIDERS
# ------------------------------------------------------------------------------
GNEWS_KEY=
NEWSAPI_KEY=
NEWSDATA_KEY=
MEDIASTACK_API_KEY=
CURRENTS_API_KEY=
PROVIDER_5_NAME=
PROVIDER_5_ENDPOINT=
PROVIDER_5_API_KEY=
PROVIDER_6_NAME=
PROVIDER_6_ENDPOINT=
PROVIDER_6_API_KEY=
PROVIDER_7_NAME=
PROVIDER_7_ENDPOINT=
PROVIDER_7_API_KEY=

# ------------------------------------------------------------------------------
# 6. ADMIN SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_AUTH_SALT=random_salt_phrase_for_hashing

# ------------------------------------------------------------------------------
# 7. BRANDING & CANONICAL DOMAIN
# ------------------------------------------------------------------------------
VITE_SITE_URL=https://hunkar24.in
VITE_FUTURE_CUSTOM_DOMAIN=hunkar24.in
VITE_BRAND_NAME=HUNKAR 24
VITE_BRAND_NAME_HI=हुंकार 24
VITE_BRAND_TAGLINE=राजस्थान की बुलंद आवाज़
VITE_LOGO_URL=/assets/hunkar24-logo.png

# ------------------------------------------------------------------------------
# 8. ANALYTICS & MONETIZATION
# ------------------------------------------------------------------------------
GOOGLE_ANALYTICS_ID=
GOOGLE_ADSENSE_PUBLISHER_ID=
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 9. FIREBASE (Optional Secondary Realtime Fallback)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=